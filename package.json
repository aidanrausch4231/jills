{
  "name": "jills",
  "version": "0.1.0",
  "description": "Jills: saved agent workflows that Jev suggests from chat and runs in isolated worktrees.",
  "type": "module",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./plugins/types": "./dist/src/plugins/types.js"
  },
  "bin": {
    "jills": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js",
    "test": "node --test --test-concurrency=4 --test-timeout=60000 'dist/test/**/*.test.js'",
    "e2e": "bash scripts/e2e-hello.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "yaml": "2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
